# These are for Azure Open AI endpoint
# Change the variables for your LLM of choice
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
OPENAI_API_VERSION=
AUTO_EVAL_4_1_SWEDEN_DEPLOYMENT=
AZURE_OPENAI_BASE_URL=

# Bucket name for running evaluations
THEMEFINDER_S3_BUCKET_NAME=

# Langfuse tracing (optional - evals run without these)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_PROJECT_ID=

# GCP Vertex AI (for Gemini and Claude benchmarks)
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# Native AWS Bedrock (recommended — see docs/bedrock.md)
# After: aws sso login --profile YOUR_PROFILE
AWS_PROFILE=
BEDROCK_MODEL_ID=
# AWS_REGION=eu-west-2
# Optional CSV export from examples/bedrock_bedrock.py (default: examples/output/bedrock)
# BEDROCK_OUTPUT_DIR=
# BEDROCK_SKIP_EXPORT=1

# Optional: LiteLLM gateway → Bedrock (see deploy/litellm/README.md)
# OpenAI-compatible base URL, must include /v1
LLM_GATEWAY_URL=http://127.0.0.1:4000/v1
# Proxy master key or virtual key (ThemeFinder client)
LITELLM_API_KEY=
# Alias from deploy/litellm/config.yaml model_list model_name
BEDROCK_LITELLM_MODEL=themefinder-claude
# Used by eval harness when reusing the same gateway
CONSULT_EVAL_LITELLM_API_KEY=

# LiteLLM proxy host only (not required in ThemeFinder if proxy holds Bedrock auth)
AWS_REGION=
LITELLM_MASTER_KEY=

# Set RUN_BEDROCK_SMOKE=1 for tests/test_bedrock_llm.py live Bedrock test
# RUN_BEDROCK_SMOKE=
# Set RUN_BEDROCK_GATEWAY_SMOKE=1 for tests/test_gateway_llm.py LiteLLM integration test
# RUN_BEDROCK_GATEWAY_SMOKE=
